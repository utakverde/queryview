@echo off
setlocal EnableExtensions DisableDelayedExpansion
title Configure SAMELCO II Reports
cd /d "%~dp0"

echo.
echo SAMELCO II Reports - Database Connection
echo Press Enter to accept each value shown in brackets.
echo.
set "DB_HOST=192.168.1.100"
set "DB_PORT=3306"
set "DB_USER=root"
set "DB_NAME_1=dbsamelco"
set "DB_NAME_2=dbsamelco_catbalogan"
set "DB_NAME_3=dbsamelco_basey"
set "DB_NAME_4=dbsamelco_villareal"
set "APP_PORT=3001"
set "APP_HOST=127.0.0.1"

set /p "INPUT=MySQL server IP or name [%DB_HOST%]: "
if defined INPUT set "DB_HOST=%INPUT%"
set "INPUT="
set /p "INPUT=MySQL port [%DB_PORT%]: "
if defined INPUT set "DB_PORT=%INPUT%"
set "INPUT="
set /p "INPUT=MySQL user [%DB_USER%]: "
if defined INPUT set "DB_USER=%INPUT%"
set "INPUT="
set /p "DB_PASSWORD=MySQL password: "
if not defined DB_PASSWORD (
  echo ERROR: A MySQL password is required.
  pause
  exit /b 1
)
set "INPUT="
set /p "INPUT=MAIN office database name [%DB_NAME_1%]: "
if defined INPUT set "DB_NAME_1=%INPUT%"
set "INPUT="
set /p "INPUT=CATBALOGAN office database name [%DB_NAME_2%]: "
if defined INPUT set "DB_NAME_2=%INPUT%"
set "INPUT="
set /p "INPUT=BASEY office database name [%DB_NAME_3%]: "
if defined INPUT set "DB_NAME_3=%INPUT%"
set "INPUT="
set /p "INPUT=VILLAREAL office database name [%DB_NAME_4%]: "
if defined INPUT set "DB_NAME_4=%INPUT%"
set /p "INPUT=Reports web port [%APP_PORT%]: "
if defined INPUT set "APP_PORT=%INPUT%"
set "INPUT="
set /p "INPUT=Allow other PCs on the LAN? Type Y for yes [N]: "
if /i "%INPUT%"=="Y" set "APP_HOST=0.0.0.0"

>"server_settings.bat" echo @echo off
>>"server_settings.bat" echo rem Generated by CONFIGURE.bat. Keep this file private.
>>"server_settings.bat" echo set "REPORT_HOST=%APP_HOST%"
>>"server_settings.bat" echo set "PORT=%APP_PORT%"
>>"server_settings.bat" echo set "NODE_EXE=%%~dp0runtime\node.exe"
>>"server_settings.bat" echo set "MYSQL_EXE=%%~dp0runtime\mysql.exe"
>>"server_settings.bat" echo set "MYSQL_HOST=%DB_HOST%"
>>"server_settings.bat" echo set "MYSQL_PORT=%DB_PORT%"
>>"server_settings.bat" echo set "MYSQL_USER=%DB_USER%"
>>"server_settings.bat" echo set "MYSQL_PASSWORD=%DB_PASSWORD%"
>>"server_settings.bat" echo set "MYSQL_DATABASE_1=%DB_NAME_1%"
>>"server_settings.bat" echo set "MYSQL_DATABASE_2=%DB_NAME_2%"
>>"server_settings.bat" echo set "MYSQL_DATABASE_3=%DB_NAME_3%"
>>"server_settings.bat" echo set "MYSQL_DATABASE_4=%DB_NAME_4%"

echo.
echo Testing database connection and required databases...
call "server_settings.bat"
"%MYSQL_EXE%" -h "%MYSQL_HOST%" -P "%MYSQL_PORT%" -u "%MYSQL_USER%" -p"%MYSQL_PASSWORD%" -N -B -e "SELECT COUNT(*) FROM information_schema.SCHEMATA WHERE SCHEMA_NAME IN ('%DB_NAME_1%','%DB_NAME_2%','%DB_NAME_3%','%DB_NAME_4%');" > "%TEMP%\samelco_db_test.txt" 2>nul
if errorlevel 1 (
  echo ERROR: The MySQL connection failed. Check the server, network, user, and password.
  del "%TEMP%\samelco_db_test.txt" >nul 2>&1
  pause
  exit /b 1
)
set /p "DB_COUNT=" < "%TEMP%\samelco_db_test.txt"
del "%TEMP%\samelco_db_test.txt" >nul 2>&1
if not "%DB_COUNT%"=="4" (
  echo ERROR: Connected successfully, but only %DB_COUNT% of 4 required databases are accessible.
  pause
  exit /b 1
)
echo Connection successful. All four databases are accessible.
exit /b 0
